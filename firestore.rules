rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sostituisci xzp5iDmxkSTXJ0RcFdzXclD0lfj1 con il tuo UID (account email/password), una sola volta.
    // L'admin deve essere entrato con email e password, non in modo anonimo.
    function admin() {
      return request.auth != null
        && request.auth.uid == 'xzp5iDmxkSTXJ0RcFdzXclD0lfj1'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function anonimo() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    // Destinataria = accesso anonimo il cui UID e' stato autorizzato (documento in /destinatari/{uid}).
    function lei() {
      return anonimo() && exists(/databases/$(database)/documents/destinatari/$(request.auth.uid));
    }
    function codiceValido(c) { return c is string && c.matches('^[a-f0-9]{32}$'); }

    function giornoValido(n) { return n.matches('^([1-9]|1[0-9]|2[0-4])$'); }

    // La casella n si apre alle 00:00 italiane del giorno n di dicembre 2026 (23:00 UTC del giorno prima).
    // request.time e' l'orologio del server: cambiare l'ora del telefono non serve a nulla.
    function sbloccata(n) {
      return giornoValido(n)
        && request.time >= timestamp.date(2026, 12, 1) + duration.value(int(n) - 1, 'd') - duration.value(1, 'h');
    }

    // ---- Autorizzazione della destinataria ----
    // Inviti: li crea e li vede solo l'admin. Il codice (128 bit casuali) e' l'ID del documento
    // e non e' scritto da nessuna parte nel repository. Si usa una volta sola, entro la scadenza.
    match /inviti/{codice} {
      allow get, list: if admin();
      allow create: if admin() && codiceValido(codice)
        && request.resource.data.keys().hasOnly(['creatoIl', 'scade', 'usato'])
        && request.resource.data.usato == false
        && request.resource.data.creatoIl == request.time
        && request.resource.data.scade is timestamp
        && request.resource.data.scade > request.time
        && request.resource.data.scade <= request.time + duration.value(7, 'd');
      // Consumo dell'invito: solo un accesso anonimo, solo se non usato e non scaduto, segnando il proprio UID.
      allow update: if anonimo() && codiceValido(codice)
        && resource.data.usato == false
        && request.time < resource.data.scade
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usato', 'uid', 'usatoIl'])
        && request.resource.data.usato == true
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usatoIl == request.time
        // Un invito puo' essere consumato solo insieme alla creazione del destinatario.
        && !exists(/databases/$(database)/documents/destinatari/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/destinatari/$(request.auth.uid)).data.codice == codice
        && getAfter(/databases/$(database)/documents/destinatari/$(request.auth.uid)).data.creatoIl == request.time;
      allow delete: if admin();
    }

    // Dispositivi autorizzati. Ci si puo' autorizzare solo presentando un invito valido,
    // consumato nella stessa operazione (batch). Solo l'admin puo' elencare o revocare.
    match /destinatari/{uid} {
      allow get: if admin() || (request.auth != null && request.auth.uid == uid);
      allow list: if admin();
      allow create: if anonimo() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['codice', 'creatoIl'])
        && codiceValido(request.resource.data.codice)
        && request.resource.data.creatoIl == request.time
        && get(/databases/$(database)/documents/inviti/$(request.resource.data.codice)).data.usato == false
        && request.time < get(/databases/$(database)/documents/inviti/$(request.resource.data.codice)).data.scade
        && getAfter(/databases/$(database)/documents/inviti/$(request.resource.data.codice)).data.usato == true
        && getAfter(/databases/$(database)/documents/inviti/$(request.resource.data.codice)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/inviti/$(request.resource.data.codice)).data.usatoIl == request.time;
      allow update: if false;
      allow delete: if admin();
    }

    // ---- Contenuti ----
    // Lei puo' solo leggere un documento alla volta (get): niente elenchi ne' query sulle raccolte.
    match /caselle/{n} {
      allow get: if giornoValido(n) && (admin() || (lei() && sbloccata(n)));
      allow list: if admin();
      allow create, update: if admin() && giornoValido(n)
        && request.resource.data.keys().hasOnly(['titolo', 'messaggio', 'tipo', 'bottoneTesto', 'bottoneLink', 'haFoto', 'fotoV', 'aggiornatoIl'])
        && request.resource.data.fotoV is number;
      allow delete: if admin() && giornoValido(n);
    }

    match /foto/{n} {
      allow get: if giornoValido(n) && (admin() || (lei() && sbloccata(n)));
      allow list: if admin();
      allow create, update: if admin() && giornoValido(n)
        && request.resource.data.keys().hasOnly(['dati', 'v'])
        && request.resource.data.v is number
        && request.resource.data.dati is string
        && request.resource.data.dati.size() < 950000;
      allow delete: if admin() && giornoValido(n);
    }

    // Aperture: le registra solo lei (e solo se la casella e' sbloccata), le legge e le ripristina solo l'admin.
    match /aperture/{n} {
      allow get: if giornoValido(n) && (admin() || lei());
      allow list: if admin();
      allow create: if lei() && sbloccata(n)
        && request.resource.data.keys().hasOnly(['apertaIl'])
        && request.resource.data.apertaIl == request.time;
      allow update: if false;
      allow delete: if admin() && giornoValido(n);
    }

    // Testi di benvenuto: pubblici di proposito (servono prima dell'accesso). Metterci solo cose non segrete.
    match /config/principale {
      allow get: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['titoloBenvenuto', 'fraseBenvenuto', 'titoloCal', 'testoCal']);
      allow delete: if admin();
    }
  }
}
